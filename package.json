{
  "name": "project-nanda",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "stop": "node scripts/free-dev-ports.cjs",
    "dev": "pnpm -r --parallel --filter @nanda/index-service --filter @nanda/weather-agent --filter @nanda/finance-agent dev",
    "dev:clean": "pnpm stop && pnpm dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel --filter @nanda/index-service --filter @nanda/weather-agent --filter @nanda/finance-agent start",
    "resolve": "pnpm --filter @nanda/resolver-client resolve",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
