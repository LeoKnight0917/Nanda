# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/crypto-utils/package.json packages/crypto-utils/package.json
COPY services/resolver-client/package.json services/resolver-client/package.json

RUN pnpm install --frozen-lockfile

COPY packages/shared-types packages/shared-types
COPY packages/crypto-utils packages/crypto-utils
COPY services/resolver-client services/resolver-client
COPY scripts/docker-e2e.mjs scripts/docker-e2e.mjs

RUN pnpm --filter @nanda/shared-types build && \
    pnpm --filter @nanda/crypto-utils build && \
    pnpm --filter @nanda/resolver-client build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/crypto-utils/package.json packages/crypto-utils/package.json
COPY services/resolver-client/package.json services/resolver-client/package.json

RUN pnpm install --prod --frozen-lockfile

COPY --from=builder /app/packages/shared-types/dist packages/shared-types/dist
COPY --from=builder /app/packages/crypto-utils/dist packages/crypto-utils/dist
COPY --from=builder /app/services/resolver-client/dist services/resolver-client/dist
COPY --from=builder /app/scripts/docker-e2e.mjs scripts/docker-e2e.mjs

ENTRYPOINT ["node", "services/resolver-client/dist/cli.js"]
